<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ISeeYou.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ISeeYou"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    Title="ISeeYou">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
                
        <StackPanel Grid.Row="0" Grid.Column="1" Padding="12">
            <Border BorderThickness="2" BorderBrush="Blue" CornerRadius="12">
                <Image Source="{x:Bind ViewModel.Bitmap, Mode=OneWay}"
                       Stretch="Fill" 
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="12" Spacing="8">
            <Button CornerRadius="32" Padding="5" Click="{x:Bind ViewModel.ButtonPlayPauseClick}" Style="{StaticResource AccentButtonStyle}">
                <Button.Content>
                    <Image Source="/Assets/Pause.png" />
                </Button.Content>
            </Button>
            <Button CornerRadius="32" Padding="5" Click="{x:Bind ViewModel.ButtonMuteDesmuteClick}" Style="{StaticResource AccentButtonStyle}">
                <Button.Content>
                    <Image Source="/Assets/Mute.png" />
                </Button.Content>
            </Button>
        </StackPanel>

    </Grid>
</Window>
