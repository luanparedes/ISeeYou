<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>I See You Detector AI</Title>
    <Authors>SunnymoonSoftwares</Authors>
    <Product>$(Authors)-$(AssemblyName)</Product>
    <Description>Yolo engine that get persons and objects to a frame display.</Description>
    <Copyright>SunnymoonSoftwares</Copyright>
    <RepositoryUrl>https://github.com/luanparedes/ISeeYou</RepositoryUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Emgu.CV" Version="4.12.0.5764" />
    <PackageReference Include="Emgu.CV.runtime.windows" Version="4.12.0.5764" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ISeeYou.Core\ISeeYou.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\Logo_800x800.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
